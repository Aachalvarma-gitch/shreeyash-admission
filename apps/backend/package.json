    "seed": "tsx seed-all.ts",
    "migrate-lead-stages": "tsx scripts/migrate-lead-stages.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "solar",
    "ocr",
    "energy",
    "analytics"
  ],
  "author": "NewRa Grids",
  "license": "MIT",
